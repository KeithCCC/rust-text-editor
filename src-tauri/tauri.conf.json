{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Koharu",
  "version": "1.2.2",
  "identifier": "lab.dailyai.koharu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Koharu",
        "width": 1200,
        "height": 800,
        "center": true,
        "maximized": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
